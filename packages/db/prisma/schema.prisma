generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  color        String            @default("#6366f1")
  avatarUrl    String?
  createdAt    DateTime          @default(now())

  memberships  WorkspaceMember[]
  pagesCreated Page[]            @relation("PageAuthor")
  invitesMade  Invite[]          @relation("InviteCreator")
  comments     Comment[]
  notifications Notification[]   @relation("NotifRecipient")
  notifsSent   Notification[]    @relation("NotifActor")
  pagePermissions PagePermission[]
  apiTokens    ApiToken[]
  pageReactions PageReaction[]
  pageSubscriptions PageSubscription[]
  reminders    Reminder[]

  // Work management (JIRA-style)
  workProjectsLed  WorkProject[]     @relation("WorkProjectLead")
  issuesAssigned   Issue[]           @relation("IssueAssignee")
  issuesReported   Issue[]           @relation("IssueReporter")
  worklogs         Worklog[]
  issueComments    IssueComment[]
  issueWatching    IssueWatcher[]
  issueActivities  IssueActivity[]
  componentsLed    WorkComponent[]   @relation("ComponentLead")
  issueAttachments IssueAttachment[]
  savedFilters     SavedFilter[]
}

model ApiToken {
  id         String   @id @default(cuid())
  userId     String
  name       String
  token      String   @unique
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  icon      String?           // emoji
  color     String?           // hex
  bannerUrl String?
  announcement String?
  defaultFont String          @default("default") // "default" | "serif" | "mono"
  defaultWidth String         @default("normal") // "normal" | "wide" | "full"
  aiEnabled   Boolean         @default(true)
  createdAt DateTime          @default(now())

  members   WorkspaceMember[]
  pages     Page[]
  invites   Invite[]
  reminders Reminder[]
  syncedBlocks SyncedBlock[]
  teamspaces Teamspace[]

  // Work management (JIRA-style)
  workProjects WorkProject[]
  labels       WorkLabel[]
  savedFilters SavedFilter[]
}

model Teamspace {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String?  // emoji
  description String?
  // "open" — any workspace member can join, "closed" — invite only, "private" — invisible to non-members
  access      String   @default("open")
  position    Float    @default(0)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       Page[]
  members     TeamspaceMember[]

  @@index([workspaceId])
}

model TeamspaceMember {
  id          String    @id @default(cuid())
  teamspaceId String
  userId      String
  role        String    @default("member") // "owner" | "member"
  createdAt   DateTime  @default(now())

  teamspace   Teamspace @relation(fields: [teamspaceId], references: [id], onDelete: Cascade)

  @@unique([teamspaceId, userId])
  @@index([teamspaceId])
  @@index([userId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("editor") // "owner" | "editor" | "viewer"
  lastActiveAt DateTime?
  mutedKinds  String    @default("[]") // JSON array of notification kinds
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Page {
  id          String    @id @default(cuid())
  workspaceId String
  teamspaceId String?
  parentId    String?
  kind        String    @default("doc")    // "doc" | "database"
  title       String    @default("Untitled")
  icon        String?   // emoji
  // BlockNote JSON snapshot (debounced from Yjs doc) — for kind="doc"
  content     String    @default("[]")
  // Schema of properties for a database page (JSON: [{id,name,type,options?}])
  dbSchema    String?
  // Property values for a row page (JSON: { propId: value })
  dataValues  String?
  position    Float     @default(0)
  authorId    String?
  cover       String?
  coverPos    String    @default("center") // "top" | "center" | "bottom"
  coverCaption String?
  coverDim    Boolean   @default(false)
  tags        String    @default("[]") // JSON array of strings
  favorite    Boolean   @default(false)
  pinned      Boolean   @default(false)
  status      String?   // null | "draft" | "in_review" | "published"
  locked      Boolean   @default(false)
  lockedUntil DateTime?
  width       String    @default("normal") // "normal" | "wide" | "full"
  font        String    @default("default") // "default" | "serif" | "mono"
  viewCount   Int       @default(0)
  publicViewCount Int   @default(0)
  wordGoal    Int?
  archivedAt  DateTime?
  expiresAt   DateTime?
  deletedAt   DateTime?
  publicSlug  String?   @unique
  publicAccess String   @default("none") // "none" | "view"
  slug        String?   // optional human-readable URL alias (unique per workspace)
  isTemplate  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamspace   Teamspace? @relation(fields: [teamspaceId], references: [id], onDelete: SetNull)
  parent      Page?     @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]    @relation("PageTree")
  author      User?     @relation("PageAuthor", fields: [authorId], references: [id])
  comments    Comment[]
  snapshots   PageSnapshot[]
  permissions PagePermission[]
  activities  PageActivity[]
  reactions   PageReaction[]
  subscriptions PageSubscription[]
  reminders   Reminder[]

  @@index([workspaceId, parentId])
  @@index([teamspaceId])
}

model PageSnapshot {
  id        String   @id @default(cuid())
  pageId    String
  content   String
  authorId  String?
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}

model PageActivity {
  id        String   @id @default(cuid())
  pageId    String
  userId    String?
  action    String   // "created" | "renamed" | "deleted" | "restored" | "shared" | "snapshot" | ...
  meta      String?  // free-form JSON
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}

model PagePermission {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  role      String   @default("view") // "view" | "comment" | "edit"
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  pageId    String
  authorId  String
  body      String
  blockId   String?  // optional anchor to a BlockNote block id
  threadId  String?  // null = top-level, else parent Comment.id
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]
  reactions CommentReaction[]

  @@index([pageId])
  @@index([threadId])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

model PageReaction {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId, emoji])
  @@index([pageId])
}

model PageSubscription {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
}

model SyncedBlock {
  id          String   @id @default(cuid())
  workspaceId String
  content     String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  pageId    String
  workspaceId String
  dueAt     DateTime
  note      String?
  sentAt    DateTime?
  repeatRule String   @default("none") // "none" | "daily" | "weekdays" | "weekly" | "monthly"
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([sentAt])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  actorId     String?
  workspaceId String
  pageId      String?
  commentId   String?
  kind        String   // "mention" | "comment_reply" | "comment_new"
  preview     String   @default("")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?    @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  role        String    @default("editor")
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
}

// ===========================================================================
// Work management (JIRA-style): first-class issue tracking, workflows, agile
// boards, sprints, and reports — distinct from the flexible Page databases.
// ===========================================================================

model WorkProject {
  id          String    @id @default(cuid())
  workspaceId String
  key         String    // short code used in issue keys, e.g. "ENG" -> ENG-12
  name        String
  description String?
  icon        String?   // emoji
  color       String?   // hex
  type        String    @default("scrum") // "scrum" | "kanban"
  leadId      String?
  nextNumber  Int       @default(1) // monotonic counter for issue keys
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        User?     @relation("WorkProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues      Issue[]
  sprints     Sprint[]
  boards      Board[]
  issueTypes  IssueType[]
  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]
  components  WorkComponent[]
  versions    WorkVersion[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model IssueType {
  id        String  @id @default(cuid())
  projectId String
  name      String
  icon      String? // emoji
  level     String  @default("standard") // "epic" | "standard" | "subtask"
  color     String?
  position  Float   @default(0)

  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([projectId])
}

model WorkflowStatus {
  id        String  @id @default(cuid())
  projectId String
  name      String
  category  String  @default("todo") // "todo" | "in_progress" | "done"
  color     String?
  position  Float   @default(0)

  project        WorkProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues         Issue[]
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")

  @@index([projectId])
}

model WorkflowTransition {
  id           String  @id @default(cuid())
  projectId    String
  name         String
  fromStatusId String? // null = global (allowed from any status)
  toStatusId   String

  project    WorkProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus? @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus  @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Issue {
  id               String    @id @default(cuid())
  projectId        String
  number           Int       // per-project sequential; key = project.key + "-" + number
  typeId           String
  statusId         String
  summary          String    @default("")
  description      String    @default("[]") // BlockNote JSON
  priority         String    @default("medium") // "highest" | "high" | "medium" | "low" | "lowest"
  assigneeId       String?
  reporterId       String?
  parentId         String?   // sub-task parent
  epicId           String?   // epic link
  sprintId         String?
  rank             Float     @default(0) // backlog / board ordering
  storyPoints      Float?
  originalEstimate Int?      // seconds
  dueDate          DateTime?
  resolution       String?   // null | "done" | "wontdo" | "duplicate" | "cannot_reproduce"
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project     WorkProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        IssueType       @relation(fields: [typeId], references: [id])
  status      WorkflowStatus  @relation(fields: [statusId], references: [id])
  assignee    User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User?           @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent      Issue?          @relation("IssueSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Issue[]         @relation("IssueSubtasks")
  epic        Issue?          @relation("IssueEpic", fields: [epicId], references: [id], onDelete: SetNull)
  epicChildren Issue[]        @relation("IssueEpic")
  sprint      Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  comments    IssueComment[]
  activities  IssueActivity[]
  watchers    IssueWatcher[]
  worklogs    Worklog[]
  attachments IssueAttachment[]
  linksOut    IssueLink[]     @relation("LinkSource")
  linksIn     IssueLink[]     @relation("LinkTarget")
  labels      IssueLabel[]
  components  IssueComponent[]
  fixVersions IssueFixVersion[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([statusId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([epicId])
  @@index([parentId])
}

model Sprint {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  goal         String?
  state        String    @default("future") // "future" | "active" | "completed"
  startDate    DateTime?
  endDate      DateTime?
  completeDate DateTime?
  sequence     Int       @default(0)
  createdAt    DateTime  @default(now())

  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([projectId])
}

model Board {
  id        String  @id @default(cuid())
  projectId String
  name      String
  type      String  @default("scrum") // "scrum" | "kanban"
  swimlane  String  @default("none")  // "none" | "assignee" | "epic" | "subtask"
  filterJql String?
  createdAt DateTime @default(now())

  project WorkProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  @@index([projectId])
}

model BoardColumn {
  id        String  @id @default(cuid())
  boardId   String
  name      String
  statusIds String  @default("[]") // JSON array of WorkflowStatus ids mapped to this column
  position  Float   @default(0)
  wipLimit  Int?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model IssueLink {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  type      String   // "blocks" | "relates" | "duplicates" | "clones"
  createdAt DateTime @default(now())

  source Issue @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Issue @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model WorkComponent {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  leadId      String?

  project WorkProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead    User?           @relation("ComponentLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues  IssueComponent[]

  @@index([projectId])
}

model WorkVersion {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  startDate   DateTime?
  releaseDate DateTime?
  released    Boolean   @default(false)
  archived    Boolean   @default(false)
  position    Float     @default(0)

  project WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueFixVersion[]

  @@index([projectId])
}

model WorkLabel {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  color       String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label WorkLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([labelId])
}

model IssueComponent {
  id          String @id @default(cuid())
  issueId     String
  componentId String

  issue     Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  component WorkComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([issueId, componentId])
  @@index([componentId])
}

model IssueFixVersion {
  id        String @id @default(cuid())
  issueId   String
  versionId String

  issue   Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  version WorkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([issueId, versionId])
  @@index([versionId])
}

model Worklog {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  seconds   Int
  startedAt DateTime @default(now())
  comment   String?
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  userId    String?
  field     String   // "status" | "assignee" | "sprint" | "points" | "created" | ...
  from      String?
  to        String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

model IssueWatcher {
  id      String @id @default(cuid())
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
}

model IssueAttachment {
  id           String   @id @default(cuid())
  issueId      String
  url          String
  name         String
  size         Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([issueId])
}

model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  jql         String
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
