{
  "name": "collab-notion",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web & npm run dev --workspace=collab",
    "dev:web": "npm run dev --workspace=web",
    "dev:collab": "npm run dev --workspace=collab",
    "db:push": "npm run db:push --workspace=db",
    "db:studio": "npm run db:studio --workspace=db"
  },
  "overrides": {
    "prosemirror-view": "1.33.10",
    "prosemirror-model": "1.23.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "prisma": "^5.10.2"
  }
}
